# =============================================================================
# Blood Donation NGO Platform - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file containing actual secrets to git
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Neon Postgres)
# -----------------------------------------------------------------------------
# Get this from your Neon project: Dashboard > Connect > Connection string
# Use the pooled connection (host contains "-pooler") for the app / Vercel.
# Admin accounts and login sessions are also stored in this database.

# Format: postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.[REGION].aws.neon.tech/[DB]?sslmode=require&channel_binding=require
DATABASE_URL=

# -----------------------------------------------------------------------------
# OPTIONAL: RATE LIMITING (Upstash Redis)
# -----------------------------------------------------------------------------
# If not configured, the app will use in-memory rate limiting
# For production, Upstash Redis is recommended for distributed rate limiting
# Get these from: https://console.upstash.com/

# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
# These can also be configured via the admin dashboard Settings page
# The database values will override these if present

# Default donation eligibility interval in days
# DONATION_ELIGIBILITY_INTERVAL_DAYS=90

# -----------------------------------------------------------------------------
# NOTES FOR PRODUCTION DEPLOYMENT
# -----------------------------------------------------------------------------
# 1. All NEXT_PUBLIC_* variables are embedded in the client bundle
#    - They are safe to use but visible to anyone
#    - Don't put secrets in NEXT_PUBLIC_* variables
#
# 2. Server-only variables (without NEXT_PUBLIC_ prefix)
#    - Only accessible on the server
#    - Perfect for secrets like DATABASE_URL
#
# 3. For Vercel deployment:
#    - Add all variables in the Vercel dashboard: Settings > Environment Variables
#    - Variables are automatically injected at build and runtime
#
# 4. For other platforms:
#    - Ensure all required variables are available at both build and runtime
#    - Use your platform's secrets management feature
